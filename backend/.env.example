# KOBİ AI Asistan Backend — Ortam Değişkenleri

# ─── Gemini API (Zorunlu) ────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Veritabanı ──────────────────────────────────────────────────────
# SQLite (yerel geliştirme):
# DATABASE_URL=sqlite+aiosqlite:///./kobi_ai.db
# PostgreSQL (Neon.tech — aşağıdaki URL'yi kendi Neon dashboard'unuzdan alın):
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/dbname?sslmode=require

# ─── Güvenlik ────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
CORS_ORIGINS=https://1ahmetonay.github.io,http://localhost:3000,http://localhost:8080,http://localhost:5000,http://localhost:5173

# ─── Uygulama Modu ──────────────────────────────────────────────────
# development: SQLite + mock fallback + debug log
# production: PostgreSQL + strict auth + minimal log
APP_ENV=development
