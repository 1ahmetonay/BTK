GEMINI_API_KEY=AIzaSyDEIwnk08gTBgffFr1BqznjDxAlGgpBpQY

# ─── Veritabanı ──────────────────────────────────────────────────────
# SQLite (yerel geliştirme):
# DATABASE_URL=sqlite+aiosqlite:///./kobi_ai.db
# PostgreSQL (Neon.tech — aşağıdaki URL'yi kendi Neon dashboard'unuzdan alın):
