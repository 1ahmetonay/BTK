# ─── Güvenlik ────────────────────────────────────────────────────────
JWT_SECRET=super-secret-kobi-ai-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# ─── Uygulama Modu ──────────────────────────────────────────────────
# development: SQLite + mock fallback + debug log
# production: PostgreSQL + strict auth + minimal log
APP_ENV=development
